{
  "id": null,
  "uid": "mood-diary-bot",
  "title": "🧠 Mood Diary Bot",
  "tags": [
    "telegram",
    "bot",
    "mood"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "type": "stat",
      "title": "🤖 Bot Status",
      "targets": [
        {
          "expr": "up{job=\"mood-diary-bot\"}",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "❌ Offline"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "text": "✅ Online"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "type": "stat",
      "title": "📬 Messages (Total)",
      "targets": [
        {
          "expr": "sum(bot_messages_total{job=\"mood-diary-bot\"})",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "type": "stat",
      "title": "⚠️ Errors (1h)",
      "targets": [
        {
          "expr": "sum(increase(bot_messages_total{status=\"error\", job=\"mood-diary-bot\"}[1h]))",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "decimals": 0
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "type": "stat",
      "title": "⏱️ Response Time P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(bot_request_duration_seconds_bucket{job=\"mood-diary-bot\"}[5m]))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "type": "timeseries",
      "title": "📬 Messages per Minute",
      "targets": [
        {
          "expr": "sum(rate(bot_messages_total{job=\"mood-diary-bot\"}[1m]))",
          "legendFormat": "Total"
        },
        {
          "expr": "sum(rate(bot_messages_total{status=\"success\", job=\"mood-diary-bot\"}[1m]))",
          "legendFormat": "Success"
        },
        {
          "expr": "sum(rate(bot_messages_total{status=\"error\", job=\"mood-diary-bot\"}[1m]))",
          "legendFormat": "Error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "lineWidth": 2,
          "fillOpacity": 20
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "type": "timeseries",
      "title": "⏱️ Response Time Distribution",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(bot_request_duration_seconds_bucket{job=\"mood-diary-bot\"}[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(bot_request_duration_seconds_bucket{job=\"mood-diary-bot\"}[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(bot_request_duration_seconds_bucket{job=\"mood-diary-bot\"}[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "lineWidth": 2,
          "fillOpacity": 20
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "type": "piechart",
      "title": "📊 Commands Distribution",
      "targets": [
        {
          "expr": "sum by (command) (rate(bot_messages_total{job=\"mood-diary-bot\"}[1h]))",
          "legendFormat": "{{command}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "pieType": "pie"
      }
    },
    {
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "type": "piechart",
      "title": "✅ vs ❌ Success Rate",
      "targets": [
        {
          "expr": "sum by (status) (rate(bot_messages_total{job=\"mood-diary-bot\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "pieType": "donut"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "success": {
                  "text": "✅ Success",
                  "color": "green"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "error": {
                  "text": "❌ Error",
                  "color": "red"
                }
              },
              "type": "value"
            }
          ]
        }
      }
    },
    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "type": "stat",
      "title": "👥 Active Users (1h)",
      "targets": [
        {
          "expr": "count(count by (user_id) (bot_messages_total{job=\"mood-diary-bot\"}))",
          "legendFormat": "Users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        }
      }
    },
    {
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "type": "table",
      "title": "📋 Top Commands (Last Hour)",
      "targets": [
        {
          "expr": "topk(10, sum by (command, status) (rate(bot_messages_total{job=\"mood-diary-bot\"}[1h])))",
          "legendFormat": "{{command}} - {{status}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  }
}