{
  "title": "🧠 Mood Diary Bot",
  "uid": "mood-diary-main",
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["mood-diary", "bot"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "platform",
        "type": "custom",
        "label": "Platform",
        "current": { "text": "All", "value": "$__all" },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "telegram", "value": "telegram" },
          { "text": "vk", "value": "vk" }
        ],
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "🤖 Bot Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bot Status",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "targets": [
        { "expr": "up{job=\"mood-diary-bot\"}", "legendFormat": "Status" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Messages",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "targets": [
        { "expr": "sum(bot_messages_total{platform=~\"$platform\"})", "legendFormat": "Messages" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Messages / min",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "targets": [
        { "expr": "sum(rate(bot_messages_total{platform=~\"$platform\"}[5m])) * 60", "legendFormat": "msg/min" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(bot_messages_total{status=\"error\",platform=~\"$platform\"}[5m])) / sum(rate(bot_messages_total{platform=~\"$platform\"}[5m]))",
          "legendFormat": "Error rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "P95 Response Time",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bot_request_duration_seconds_bucket{platform=~\"$platform\"}[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Registered Users",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "targets": [
        { "expr": "sum(bot_users_registered_total{platform=~\"$platform\"})", "legendFormat": "Users" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": 0 }] }
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Export P95",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bot_export_duration_seconds_bucket{platform=~\"$platform\"}[10m])) by (le))",
          "legendFormat": "P95 export"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] }
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Total Errors",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "targets": [
        { "expr": "sum(bot_errors_total{platform=~\"$platform\"})", "legendFormat": "Errors" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] }
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "📬 Message Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Messages per Minute by Platform",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (platform) (rate(bot_messages_total{platform=~\"$platform\"}[1m])) * 60",
          "legendFormat": "{{ platform }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Success vs Errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(bot_messages_total{status=\"success\",platform=~\"$platform\"}[1m])) * 60",
          "legendFormat": "Success"
        },
        {
          "expr": "sum(rate(bot_messages_total{status=\"error\",platform=~\"$platform\"}[1m])) * 60",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Errors" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "⏱️ Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Response Time Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(bot_request_duration_seconds_bucket{platform=~\"$platform\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(bot_request_duration_seconds_bucket{platform=~\"$platform\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(bot_request_duration_seconds_bucket{platform=~\"$platform\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Response Time by Command",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (command, le) (rate(bot_request_duration_seconds_bucket{platform=~\"$platform\"}[5m])))",
          "legendFormat": "{{ command }} P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "📊 Commands",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "id": 17,
      "type": "piechart",
      "title": "Commands Distribution",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (command) (increase(bot_messages_total{platform=~\"$platform\"}[24h]))",
          "legendFormat": "{{ command }}"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      }
    },
    {
      "id": 18,
      "type": "piechart",
      "title": "Platform Distribution",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum by (platform) (increase(bot_messages_total[24h]))",
          "legendFormat": "{{ platform }}"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Top Commands (Last Hour)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "sort_desc(sum by (command, platform, status) (increase(bot_messages_total{platform=~\"$platform\"}[1h])))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "options": { "sortBy": [{ "displayName": "Value", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Count" }, { "id": "custom.width", "value": 80 }] }
        ]
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "🗄️ Infrastructure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 33 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 33 },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "Memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 }] }
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "PostgreSQL Active Connections",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 33 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"mood_diary\"}",
          "legendFormat": "Active connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 45 }] }
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "PostgreSQL Query Duration (P95)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "rate(pg_stat_statements_total_time_seconds{datname=\"mood_diary\"}[5m]) / rate(pg_stat_statements_calls_total{datname=\"mood_diary\"}[5m])",
          "legendFormat": "Avg query time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Redis Memory Usage",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used memory"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    }
  ]
}